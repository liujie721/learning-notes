/**
 * Spring Security 核心配置类（项目安全总开关）
 * 1. 放行接口配置
 * 2. 认证/授权规则配置
 * 3. 跨域、会话、CSRF配置
 * 4. 密码加密器配置
 */
@Configuration
@EnableWebSecurity // 开启Spring Security安全配置
public class SecurityConfig {

    /**
     * 核心过滤器链配置（总控所有安全规则）
     */
    @Bean
    public SecurityFilterChain securityFilterChain(HttpSecurity http) throws Exception {
        http
                // 1. 关闭CSRF防护（前后端分离项目必须关闭）
                .csrf(csrf -> csrf.disable())

                // 2. 跨域配置（启用自定义跨域规则）
                .cors(cors -> cors.configurationSource(corsConfigurationSource()))

                // 3. 会话管理（前后端分离使用TOKEN，禁用Session）
                .sessionManagement(session -> session.sessionCreationPolicy(SessionCreationPolicy.STATELESS))

                // 4. 权限拦截规则配置（核心！）
                .authorizeHttpRequests(auth -> auth
                        // 放行白名单接口（无需登录即可访问）
                        .requestMatchers(
                                "/user/login",        // 登录接口
                                "/user/register",     // 注册接口
                                "/captcha/**",        // 验证码接口
                                "/swagger-ui/**",     // Swagger文档
                                "/v3/api-docs/**",    // OpenAPI接口文档
                                "/doc.html"           // Knife4j文档
                        ).permitAll()

                        // 管理员接口：需要 ADMIN 权限
                        .requestMatchers("/admin/**").hasRole("ADMIN")

                        // 普通用户接口：需要 USER 权限
                        .requestMatchers("/user/**").hasRole("USER")

                        // 所有请求：必须登录认证后才能访问
                        .anyRequest().authenticated()
                );

        // 如果需要自定义登录页/登录成功/失败处理器，在这里扩展
        // http.formLogin(form -> form.loginPage("/login").permitAll());

        return http.build();
    }

    /**
     * 跨域配置（前后端分离必备）
     */
    @Bean
    public CorsConfigurationSource corsConfigurationSource() {
        CorsConfiguration config = new CorsConfiguration();
        // 允许的前端域名（生产环境改为具体域名）
        config.setAllowedOrigins(Arrays.asList("http://localhost:8080", "http://localhost:3000"));
        // 允许的请求方式
        config.setAllowedMethods(Arrays.asList("GET", "POST", "PUT", "DELETE", "OPTIONS"));
        // 允许的请求头
        config.setAllowedHeaders(Arrays.asList("*"));
        // 允许携带Cookie
        config.setAllowCredentials(true);
        // 预检请求有效期
        config.setMaxAge(3600L);

        UrlBasedCorsConfigurationSource source = new UrlBasedCorsConfigurationSource();
        source.registerCorsConfiguration("/**", config);
        return source;
    }

    /**
     * 密码加密器（Spring Security强制要求）
     * 注册/登录密码加密、校验统一使用这个Bean
     */
    @Bean
    public PasswordEncoder passwordEncoder() {
        return new BCryptPasswordEncoder();
    }
}
